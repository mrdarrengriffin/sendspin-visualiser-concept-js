---
/** Title, artist/album and a progress bar, filled by the player script from the metadata role. */
---
<div class="track">
  <div class="title" data-track="title">&nbsp;</div>
  <div class="artist" data-track="artist">&nbsp;</div>
  <div class="progress"><div data-track="progress"></div></div>
</div>

<style>
  .track { text-align: center; padding: 16px var(--gutter) 0; }
  .title { font-size: 20px; font-weight: 600; overflow-wrap: anywhere; text-wrap: balance; }
  .artist { color: var(--muted); margin-top: 2px; overflow-wrap: anywhere; text-wrap: balance; }
  .progress { width: min(100%, 520px); height: 3px; background: #fff2; margin: 12px auto 0; border-radius: 2px; overflow: hidden; }
  .progress > div { height: 100%; width: 0; background: var(--fg); opacity: 0.7; }

  @media (max-width: 760px) {
    .track { padding-top: 12px; }
    .title { font-size: 17px; }
    .artist { font-size: 14px; }
  }
</style>
