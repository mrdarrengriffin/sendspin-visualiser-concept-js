---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import Layout from '../layouts/Layout.astro';
import HttpsWarning from '../components/HttpsWarning.astro';
import ControlBar from '../components/ControlBar.astro';
import Logo from '../components/Logo.astro';
import TrackInfo from '../components/TrackInfo.astro';
import PaletteStrip from '../components/PaletteStrip.astro';
import BeatDebug from '../components/BeatDebug.astro';
---
<Layout title="Sendspin visualiser">
  <div class="page">
    <HttpsWarning />
    <ControlBar />
    <main class="stage"><Logo /></main>
    <footer class="info">
      <TrackInfo />
      <PaletteStrip />
      <BeatDebug />
      <nav class="links"><a href={`${base}/lab`}>Logo lab</a> · <a href={`${base}/docs/`}>Docs</a> · <a href="https://github.com/mrdarrengriffin/sendspin-visualiser-concept-js">Source</a></nav>
    </footer>
  </div>
  <script src="../scripts/player.ts"></script>
</Layout>

<style>
  /* 100dvh so the mobile URL bar collapsing does not leave a gap under the footer.
     minmax(0, 1fr): an implicit auto column would take its width from the widest debug line,
     stretching the control bar and the whole page sideways whenever debug is on. */
  .page { min-height: 100vh; min-height: 100dvh; display: grid; grid-template-rows: auto auto 1fr auto; grid-template-columns: minmax(0, 1fr); }
  .stage { display: grid; place-items: center; padding: 8px var(--gutter); min-height: 0; }
  .info { padding: 0 var(--gutter) calc(20px + var(--safe-b)); }
  .links { text-align: center; margin-top: 18px; font-size: 12px; color: var(--muted); }

  @media (max-width: 760px) {
    /* Size the mark against both axes so it never pushes the track info off screen. */
    .stage { --logo-size: min(86vw, 50vh); padding: 4px var(--gutter); }
    .links { margin-top: 20px; font-size: 13px; }
    .links a { display: inline-block; padding: 6px 2px; }
  }

  /* Phone held sideways: height is the scarce axis. */
  @media (max-height: 520px) and (orientation: landscape) {
    .stage { --logo-size: min(60vw, 62vh); padding: 4px var(--gutter); }
    .info { padding-bottom: calc(12px + var(--safe-b)); }
    .links { margin-top: 12px; }
  }
</style>
