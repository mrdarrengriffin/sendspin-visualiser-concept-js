---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'The Sendspin logo as a music visualiser, driven by the Sendspin protocol.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/sendspin.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
