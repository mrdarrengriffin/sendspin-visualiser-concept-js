---
import Layout from './Layout.astro';

interface Props {
  frontmatter: { title: string; description?: string };
}
const { frontmatter } = Astro.props;
const pages = [
  { href: '/docs/', label: 'Overview' },
  { href: '/docs/geometry', label: 'Geometry' },
  { href: '/docs/animation', label: 'Animation' },
  { href: '/docs/beat-sync', label: 'Beat sync' },
  { href: '/docs/sendspin-integration', label: 'Sendspin integration' },
  { href: '/docs/porting', label: 'Porting' },
];
---
<Layout title={`${frontmatter.title} · Sendspin visualiser`} description={frontmatter.description}>
  <div class="docs">
    <nav>
      <a class="brand" href="/">Sendspin visualiser</a>
      <a href="/lab">Lab</a>
      <span class="sep">Docs</span>
      {pages.map((p) => <a href={p.href} aria-current={Astro.url.pathname.replace(/\/$/, '') === p.href.replace(/\/$/, '') ? 'page' : undefined}>{p.label}</a>)}
    </nav>
    <main>
      <slot />
    </main>
  </div>
</Layout>

<style is:global>
  .docs { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: 100vh; }
  .docs nav { padding: 24px 16px; border-right: 1px solid #fff2; display: flex; flex-direction: column; gap: 6px; font-size: 14px; position: sticky; top: 0; align-self: start; }
  .docs nav a { color: var(--fg); text-decoration: none; padding: 4px 8px; border-radius: 6px; }
  .docs nav a:hover, .docs nav a[aria-current="page"] { background: #fff2; }
  .docs nav .brand { font-weight: 600; margin-bottom: 10px; }
  .docs nav .sep { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 12px; padding: 0 8px; }
  .docs main { padding: 32px 40px 64px; max-width: 880px; line-height: 1.55; }
  .docs main h1 { font-size: 30px; margin-top: 0; }
  .docs main h2 { margin-top: 2em; border-bottom: 1px solid #fff2; padding-bottom: 4px; }
  .docs main table { border-collapse: collapse; font-size: 14px; }
  .docs main th, .docs main td { border: 1px solid #fff2; padding: 5px 10px; text-align: left; }
  .docs main code { background: #fff1; padding: 1px 5px; border-radius: 4px; font-size: 0.92em; }
  .docs main pre { background: #0006; padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
  .docs main pre code { background: none; padding: 0; }
  @media (max-width: 760px) { .docs { grid-template-columns: 1fr; } .docs nav { position: static; border-right: 0; border-bottom: 1px solid #fff2; } }
</style>
